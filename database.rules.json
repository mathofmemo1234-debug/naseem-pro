{
  "rules": {
    "offers": {
      ".read": true,
      ".write": "auth != null"
    },
    "reviews": {
      ".read": true,
      ".write": "auth != null",
      "$reviewId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'stars', 'text', 'createdAt', 'approved']) && newData.child('approved').val() === false",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "stars": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
        "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000" },
        "approved": { ".validate": "newData.isBoolean()" },
        "createdAt": { ".validate": "newData.isNumber()" }
      }
    },
    "products": {
      ".read": true,
      ".write": "auth != null",
      "$productId": {
        ".validate": "newData.hasChildren(['name', 'type', 'description', 'features', 'price', 'imageUrl', 'createdAt'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150" },
        "type": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "badge": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "description": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000" },
        "features": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "price": { ".validate": "newData.isNumber()" },
        "imageUrl": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" }
      }
    }
  }
}
